{
  "name": "ai-support-ticket-triage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.0",
  "description": "Local React support-ticket workspace with Express, Gemini, Zod and MongoDB.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build frontend",
    "dev:frontend": "vite frontend --host 127.0.0.1",
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "test": "node --test ticket-schema.test.js tests/*.test.js services/*.test.js",
    "check:ai": "node --env-file=.env scripts/check-ai.mjs",
    "check:db": "node --env-file=.env scripts/check-db.mjs",
    "check:flow": "node scripts/check-flow.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
